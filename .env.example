# 이 파일을 .env로 복사한 뒤 본인의 키를 입력하세요.
DART_API_KEY=your_opendart_api_key
# 키움 API 차트를 사용할 때만 두 값을 입력합니다. 네이버 증권 연결만 사용하면 비워 두세요.
KIWOOM_APP_KEY=your_kiwoom_app_key
KIWOOM_APP_SECRET=your_kiwoom_app_secret

# 기본은 이 PC에서만 접속합니다. 모바일은 npm run start:lan으로 실행합니다.
HOST=127.0.0.1
PORT=4180
DATABASE_PATH=.local/stock-insight.sqlite
