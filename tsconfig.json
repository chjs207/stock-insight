{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@cloudflare/workers-types"]
  },
  "include": ["src", "app", "lib", "scripts", "tests", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", ".data"]
}
