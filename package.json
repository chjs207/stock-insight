{
  "name": "stock-insight-local",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --use-system-ca --experimental-strip-types server/start.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-system-ca --experimental-strip-types server/start.ts",
