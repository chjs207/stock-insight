    "db:import": "node --experimental-strip-types server/import.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "lightweight-charts": "^5.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.0"
  }
}
